# For local dev against a local backend only. This file is gitignored, so EAS Build's cloud
# builder never sees it - the APK's real backend URL comes from eas.json's build.preview.env
# instead (currently the deployed Render URL), independent of whatever is set here.
# Android emulator: use 10.0.2.2 to reach your computer's localhost
# Physical device on same WiFi: use your computer's LAN IP, e.g. http://192.168.1.23:8080/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api
